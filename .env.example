# Local configuration. scripts/setup.sh (or setup.bat) copies this to .env and generates the secrets.
# .env is read by the app (spring.config.import) and by docker compose. Never commit .env.

# Database (used by the app and by the db container)
DB_NAME=app
DB_USERNAME=app
DB_PASSWORD=app
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/app
# Connections per instance; instances x DB_POOL_SIZE must stay below the server's max_connections.
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=5000
# Queries running longer are cancelled by PostgreSQL (0 disables it).
DB_STATEMENT_TIMEOUT=30s
DB_IDLE_IN_TRANSACTION_TIMEOUT=60s

# Redis (cache). Cached entries expire after CACHE_TTL.
REDIS_HOST=localhost
REDIS_PORT=6379
# Set both for a managed Redis (password/ACL and TLS); leave empty locally.
# For a Redis ACL user, also set SPRING_DATA_REDIS_USERNAME.
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
CACHE_TTL=10m

# Mail. Defaults use Mailpit from compose (UI: http://localhost:8025).
MAIL_HOST=localhost
MAIL_PORT=1025
# The prod profile requires TLS: STARTTLS on port 587, or implicit TLS on 465 with
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true. False only for a relay without TLS.
# MAIL_STARTTLS_REQUIRED=true
MAIL_FROM=no-reply@example.com
# Frontend handling /verify-email?token=... and /reset-password?token=...
MAIL_LINK_BASE_URL=http://localhost:3000
REQUIRE_VERIFIED_EMAIL=false
# Also check new passwords against Have I Been Pwned (only a 5-character hash prefix is sent).
# The bundled list of common passwords is always checked.
PWNED_CHECK_ENABLED=false

# JWT signing: HS256 with JWT_SECRET (at least 43 random characters, e.g. openssl rand -base64 48) or RS256 with
# JWT_PRIVATE_KEY (PEM).
# Both take a comma-separated list for key rotation: the first key signs, all keys verify.
JWT_ALGORITHM=HS256
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=1d
JWT_REMEMBER_ME_TTL=30d
# A session ends this long after the login, however often it is refreshed
JWT_MAX_SESSION_TTL=7d
JWT_REMEMBER_ME_MAX_SESSION_TTL=90d

# Encrypts two-factor (TOTP) secrets in the database: at least 32 random characters. Keep it out of the
# database backups; changing it breaks every enrolled authenticator (recovery codes still work).
MFA_ENCRYPTION_KEY=

# Optional login with GitHub and Google: a provider is enabled when its client id and secret are set.
# OAUTH2_REDIRECT_URI is the frontend page the providers redirect to; register it at both.
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to true when served over HTTPS
COOKIE_SECURE=false
# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Initial admin, created on startup if no admin exists. The password needs at least 15 characters and
# must not be a common or breached password; scripts/setup.sh generates one.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

PORT=8080
