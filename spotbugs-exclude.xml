<?xml version="1.0" encoding="UTF-8"?>
<!-- SpotBugs findings accepted on purpose; each entry says why. -->
<FindBugsFilter>
    <!--
      Spring injects shared beans through constructors and records hold the collections they are given;
      defensive copies of either would be wrong (beans) or pointless (immutable configuration).
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- Finalizer attacks need a subclass with a finalizer; Spring beans are not subclassed by untrusted code. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!--
      FindSecBugs marks every controller method for manual review. Each one is covered by deny-by-default
      security (SecurityConfig), @PreAuthorize role checks and the OpenAPI contract tests.
    -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>
    <!--
      The auth cookies hold the tokens on purpose: HttpOnly, SameSite=Strict and Secure in production. The device
      cookie (KnownDevices) holds a random id that is stored only as its SHA-256 and only recognizes a browser.
    -->
    <Match>
        <Bug pattern="COOKIE_USAGE"/>
        <Or>
            <Class name="com.hikmethankolay.template.auth.AuthController"/>
            <Class name="com.hikmethankolay.template.auth.KnownDevices"/>
            <Class name="com.hikmethankolay.template.security.CookieBearerTokenResolver"/>
        </Or>
    </Match>
    <!--
      Log lines whose values cannot hold a line break: AuditLog's storage error names the event's fixed action and an
      exception class; DevelopmentSettingsWarning names a database host parsed by java.net.URI from configuration.
    -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
        <Class name="com.hikmethankolay.template.audit.AuditLog"/>
        <Method name="store"/>
    </Match>
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
        <Class name="com.hikmethankolay.template.config.DevelopmentSettingsWarning"/>
    </Match>
    <!--
      CookieCsrfFilter reads Origin, Host and X-Requested-With to stop cross-site requests. In such a request the
      victim's browser sets them: pages cannot forge Origin or Host, and adding X-Requested-With from another site
      needs a CORS preflight the API refuses. A client that forges them itself already holds the cookie.
    -->
    <Match>
        <Bug pattern="SERVLET_HEADER,SERVLET_SERVER_NAME"/>
        <Class name="com.hikmethankolay.template.security.CookieCsrfFilter"/>
    </Match>
    <!--
      The Have I Been Pwned range API is keyed by SHA-1 (k-anonymity lookup); the digest is never stored or used to
      protect anything. Passwords are hashed with Argon2id (SecurityConfig).
    -->
    <Match>
        <Bug pattern="WEAK_MESSAGE_DIGEST_SHA1"/>
        <Class name="com.hikmethankolay.template.user.validation.BreachedPasswordValidator"/>
    </Match>
    <!--
      ProductionSettingsCheck holds the local database password only to refuse it in production, and lower-cases
      URI hosts, which java.net.URI returns in ASCII (internationalized names stay in Punycode).
    -->
    <Match>
        <Bug pattern="HARD_CODE_PASSWORD,IMPROPER_UNICODE"/>
        <Class name="com.hikmethankolay.template.config.ProductionSettingsCheck"/>
    </Match>
    <!--
      The User-Agent of a refresh is stored only to show it in the session list (cut to 255 characters); no decision
      depends on it.
    -->
    <Match>
        <Bug pattern="SERVLET_HEADER_USER_AGENT"/>
        <Class name="com.hikmethankolay.template.auth.RefreshTokenService"/>
    </Match>
    <!--
      KnownDevices names the device in the new-login email by its User-Agent and groups cookieless clients by it. A
      forged one can at most make a login look new, or familiar to someone who also shares the account's /24 network
      and already has its password; the device cookie, not the header, is what recognizes a browser.
    -->
    <Match>
        <Bug pattern="SERVLET_HEADER_USER_AGENT"/>
        <Class name="com.hikmethankolay.template.auth.KnownDevices"/>
    </Match>
    <!-- HttpSecurity.build() declares "throws Exception", so the filter chain beans must too. -->
    <Match>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
        <Class name="com.hikmethankolay.template.security.SecurityConfig"/>
    </Match>
    <!--
      These log calls contain no user input: exception messages from Redis or SMTP, ids of verified tokens
      and users, template email subjects, a database constraint name and the configured admin name, plus
      login provider errors with their line breaks removed. User input reaches the logs only through
      AuditLog, which strips line breaks (and ECS JSON logs escape them).
    -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
        <Or>
            <Class name="com.hikmethankolay.template.auth.MfaChallengeService"/>
            <Class name="com.hikmethankolay.template.social.SocialProfileClient"/>
            <Class name="com.hikmethankolay.template.common.GlobalExceptionHandler"/>
            <Class name="com.hikmethankolay.template.mail.EmailOutbox"/>
            <Class name="com.hikmethankolay.template.mail.BroadcastService"/>
            <Class name="com.hikmethankolay.template.security.LoginAttemptService"/>
            <Class name="com.hikmethankolay.template.security.RateLimitFilter"/>
            <Class name="com.hikmethankolay.template.security.TokenRevocationService"/>
            <Class name="com.hikmethankolay.template.user.AdminBootstrap"/>
        </Or>
    </Match>
</FindBugsFilter>
